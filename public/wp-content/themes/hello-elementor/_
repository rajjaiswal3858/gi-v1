.hwf.hwf.hwf .hwf-news-inner{display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:14px 28px;}
.hwf.hwf.hwf .hwf-news-logo{width:116px; height:auto; min-height:26px;}
.hwf.hwf.hwf .hwf-news-copy{font-size:15px; color:var(--t2); max-width:40ch; text-wrap:pretty;}
.hwf.hwf.hwf .hwf-news-copy strong{color:var(--cyan); font-weight:700;}
.hwf.hwf.hwf .hwf-news-form{display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:nowrap; flex:0 1 auto; min-width:0;}
.hwf.hwf.hwf .hwf-news-field{display:flex; flex:1 1 250px; min-width:140px;}
.hwf.hwf.hwf .hwf-news-input{width:100%; height:46px; padding:0 16px; border-radius:10px; background:rgba(255,255,255,.04); border:1px solid var(--hair2); color:var(--w); font-size:16px; transition:border-color var(--d2) var(--ease), background var(--d2) var(--ease), box-shadow var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-news-input::placeholder{color:var(--t4);}
.hwf.hwf.hwf .hwf-news-input:focus{outline:none; border-color:var(--teal); background:rgba(58,189,188,.06); box-shadow:0 0 0 3px rgba(58,189,188,.16);}
.hwf.hwf.hwf .hwf-news-input.is-ready{border-color:var(--teal);}
.hwf.hwf.hwf .hwf-news-input.is-warn{border-color:var(--amber); box-shadow:0 0 0 3px rgba(248,200,17,.14);}
.hwf.hwf.hwf .hwf-news-hint{flex-basis:100%; text-align:center; font-size:13px; color:var(--amber); min-height:0; opacity:0; transform:translateY(-4px); transition:opacity var(--d2) var(--ease), transform var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-news-hint.is-on{opacity:1; transform:none;}
.hwf.hwf.hwf .hwf-news-note{flex-basis:100%; text-align:center; font-size:13px; line-height:1.6; color:var(--t4);}
.hwf.hwf.hwf .hwf-news-note a{color:var(--t3); text-decoration:none; transition:color var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-news-note a:hover{color:var(--cyan);}
/* HubSpot newsletter mount. The form itself is styled by a sheet the script
   injects (it may render inside HubSpot's iframe, where this CSS can't reach).
   Without JS, or if HubSpot fails to load, the plain link is shown instead. */
.hwf.hwf.hwf .hwf-news-act{display:flex; flex-direction:column; align-items:center; flex:0 1 440px; min-width:0;}
.hwf.hwf.hwf .hwf-hs{width:100%;}
.hwf.hwf.hwf .hwf-hs:empty{display:none;}
/* fallback link stays visible while idle or failed; hidden only while the
   HubSpot form is loading or mounted */
.hwf.hwf.hwf .hwf-news-act.is-loading .hwf-hs-alt,.hwf.hwf.hwf .hwf-news-act.is-ready .hwf-hs-alt{display:none !important;}
.hwf.hwf.hwf .hwf-news-act.is-loading{width:100%; height:46px; border-radius:10px; background:rgba(255,255,255,.04); border:1px solid var(--hair2);}

/* CTA · primary */
.hwf.hwf.hwf .hwf-cta{position:relative; display:inline-flex; align-items:center; gap:12px; flex:none; height:52px; font-weight:700; font-size:16px; letter-spacing:-.01em; color:var(--nb); background:var(--teal); padding:0 9px 0 24px; border-radius:10px; overflow:hidden; transition:background var(--d2) var(--ease), transform var(--d2) var(--ease), box-shadow var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-cta::after{content:""; position:absolute; top:0; left:-130%; width:55%; height:100%; background:linear-gradient(105deg, transparent, rgba(255,255,255,.45), transparent); transform:skewX(-18deg); pointer-events:none;}
.hwf.hwf.hwf .hwf-cta:hover{transform:translateY(-2px); box-shadow:0 12px 30px -14px rgba(58,189,188,.9);}
.hwf.hwf.hwf .hwf-cta:hover::after{animation:hwf-sheen 900ms var(--ease);}
.hwf.hwf.hwf .hwf-cta:hover .hwf-ar{background:rgba(21,25,32,.28); transform:translateX(3px);}
.hwf.hwf.hwf .hwf-cta:active{transform:translateY(0);}
@keyframes hwf-sheen{from{left:-130%;}to{left:130%;}}
/* CTA · ghost teal */
/* Standalone on purpose: it does NOT extend .hwf-cta, so it inherits no
   sheen pseudo-element, no lift transform, no glow shadow and no overflow
   clip. Only paint properties transition — hovering it cannot change this
   element's box, so it can never feed the panel's ResizeObserver. */
.hwf.hwf.hwf .hwf-sub{display:inline-flex; align-items:center; justify-content:center; gap:10px; flex:none;
  height:46px; padding:0 20px; border:1px solid #3ABDBC; border-radius:10px;
  font-family:'Open Sans','Helvetica Neue',Arial,sans-serif; font-size:15px; font-weight:700; line-height:1; letter-spacing:-.01em; white-space:nowrap;
  color:#3ABDBC; background-color:transparent;
  transition:color 200ms cubic-bezier(.2,.8,.2,1), background-color 200ms cubic-bezier(.2,.8,.2,1), border-color 200ms cubic-bezier(.2,.8,.2,1);}
.hwf.hwf.hwf .hwf-sub svg{width:16px; height:16px; flex:none;}
.hwf.hwf.hwf .hwf-sub:hover{color:#BFEFEF; background-color:rgba(58,189,188,.14); border-color:#BFEFEF;}
.hwf.hwf.hwf .hwf-sub.is-ready{color:#151920; background-color:#3ABDBC; border-color:#3ABDBC;}

/* ---------- LINK COLUMNS ---------- */
.hwf.hwf.hwf .hwf-cols{display:grid; grid-template-columns:repeat(5,minmax(0,1fr)) 1.6fr; gap:32px 26px; padding:36px 0 30px;}
.hwf.hwf.hwf .hwf-col-h{position:relative; font-family:var(--fd); font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--cyan); padding-bottom:10px; margin-bottom:16px;}
.hwf.hwf.hwf .hwf-col-h::after{content:""; position:absolute; left:0; bottom:0; width:100%; height:1px; background:var(--hair2); transform:scaleX(0); transform-origin:left; transition:transform 500ms var(--ease) 120ms;}
.hwf.hwf.hwf .hwf-col.hwf-in .hwf-col-h::after{transform:scaleX(1);}
.hwf.hwf.hwf .hwf-col-list{display:flex; flex-direction:column; gap:11px;}
.hwf.hwf.hwf .hwf-col-list a{position:relative; display:inline-block; font-size:15px; line-height:1.4; color:var(--t2); width:fit-content; transition:color var(--d2) var(--ease), transform var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-col-list a::after{content:""; position:absolute; left:0; bottom:-3px; width:100%; height:1px; background:var(--blue); transform:scaleX(0); transform-origin:left; transition:transform var(--d3) var(--ease);}
.hwf.hwf.hwf .hwf-col-list a:hover{color:var(--w); transform:translateX(4px);}
.hwf.hwf.hwf .hwf-col-list a:hover::after{transform:scaleX(1);}
.hwf.hwf.hwf .hwf-col-list--ind a{display:inline-flex; align-items:center; gap:10px;}
.hwf.hwf.hwf .hwf-col-list--ind a::after{left:30px; width:calc(100% - 30px);}
.hwf.hwf.hwf .hwf-ind-ic{width:20px; height:20px; flex:none; color:var(--blue); opacity:.75; transition:opacity var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-col-list--ind a:hover .hwf-ind-ic{opacity:1;}
.hwf.hwf.hwf .hwf-manifesto{display:inline-flex; align-items:center; gap:7px; margin-top:12px; font-size:13px; color:var(--t3); transition:color var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-manifesto:hover{color:var(--w);}
.hwf.hwf.hwf .hwf-manifesto:hover .hwf-ar--bare{transform:translateX(3px);}

/* get in touch */
.hwf.hwf.hwf .hwf-col--touch{display:flex; flex-direction:column; align-items:flex-start;}
.hwf.hwf.hwf .hwf-touch-link{position:relative; font-size:19px; font-weight:800; letter-spacing:-.01em; color:var(--w); margin-bottom:12px;}
.hwf.hwf.hwf .hwf-touch-link::after{content:""; position:absolute; left:0; bottom:-3px; width:100%; height:2px; background:var(--blue); transform:scaleX(0); transform-origin:left; transition:transform var(--d3) var(--ease);}
.hwf.hwf.hwf .hwf-touch-link:hover{color:var(--cyan);}
.hwf.hwf.hwf .hwf-touch-link:hover::after{transform:scaleX(1);}
.hwf.hwf.hwf .hwf-phone-row{display:flex; align-items:center; gap:6px;}
.hwf.hwf.hwf .hwf-touch-phone{font-family:var(--fd); font-size:17px; font-weight:600; letter-spacing:-.01em; color:var(--w); transition:color var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-touch-phone:hover{color:var(--cyan);}
.hwf.hwf.hwf .hwf-cpy{position:relative; display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:8px; color:var(--t3); transition:color var(--d2) var(--ease), background var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-cpy:hover{color:var(--w); background:var(--sh);}
.hwf.hwf.hwf .hwf-cpy svg{width:16px; height:16px;}
.hwf.hwf.hwf .hwf-copy-i{transition:opacity var(--d1) var(--ease);}
.hwf.hwf.hwf .hwf-copy-ok{position:absolute; inset:0; margin:auto; color:var(--teal); opacity:0; transform:scale(.9); transition:opacity var(--d1) var(--ease), transform var(--d1) var(--ease);}
.hwf.hwf.hwf .hwf-cpy.is-done .hwf-copy-i{opacity:0;}
.hwf.hwf.hwf .hwf-cpy.is-done .hwf-copy-ok{opacity:1; transform:none;}
.hwf.hwf.hwf .hwf-copy-pill{position:absolute; bottom:calc(100% + 6px); left:50%; transform:translate(-50%,4px); padding:4px 8px; border-radius:6px; background:var(--s2); border:1px solid var(--hair2); font-family:var(--fd); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--teal); white-space:nowrap; opacity:0; visibility:hidden; pointer-events:none; transition:opacity var(--d2) var(--ease), transform var(--d2) var(--ease), visibility 0s linear var(--d2);}
.hwf.hwf.hwf .hwf-cpy.is-done .hwf-copy-pill{opacity:1 !important; visibility:visible !important; transform:translate(-50%,0);  transition-delay:0s;}
.hwf.hwf.hwf .hwf-hiring{display:inline-flex; align-items:center; gap:8px; margin-top:14px; padding:8px 14px; border:1px solid var(--hair2); border-radius:999px; font-size:13px; font-weight:600; color:var(--t2); transition:color var(--d2) var(--ease), border-color var(--d2) var(--ease), background var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-hiring:hover{color:var(--w); border-color:rgba(58,189,188,.5); background:rgba(58,189,188,.08);}
.hwf.hwf.hwf .hwf-hiring:hover .hwf-ar--bare{transform:translateX(3px);}
.hwf.hwf.hwf .hwf-dot{width:7px; height:7px; border-radius:50%; background:var(--blue); flex:none;}
.hwf.hwf.hwf .reveal.hwf-in .hwf-dot{animation:hwf-pulse 2.6s var(--ease) infinite;}
@keyframes hwf-pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.hwf.hwf.hwf .hwf-social{display:flex; flex-wrap:wrap; gap:8px; margin-top:18px;}
.hwf.hwf.hwf .hwf-social li{display:flex;}
.hwf.hwf.hwf .hwf-soc{width:36px; height:36px; flex:none; border-radius:50%; border:1px solid var(--hair2); color:var(--t2); display:flex; align-items:center; justify-content:center; transition:background var(--d2) var(--ease), color var(--d2) var(--ease), border-color var(--d2) var(--ease), transform var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-soc svg{width:16px; height:16px;}
.hwf.hwf.hwf .hwf-soc:hover{background:var(--teal); color:var(--nb); border-color:var(--teal); transform:translateY(-3px);}

/* ---------- PARTNERS + RECOGNITION ---------- */
.hwf.hwf.hwf .hwf-trust{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px 40px; padding:18px 0; border-top:1px solid var(--hair);}
.hwf.hwf.hwf .hwf-trust-g{display:flex; align-items:center; flex-wrap:wrap; gap:10px 16px; min-width:0;}
.hwf.hwf.hwf .hwf-trust-g--tick{flex:1 1 340px; flex-wrap:nowrap; min-width:0; justify-content:flex-end;}
.hwf.hwf.hwf .hwf-trust-h{flex:none; font-family:var(--fd); font-size:11px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--t4);}
.hwf.hwf.hwf .hwf-chips{display:flex; flex-wrap:wrap; gap:10px;}
.hwf.hwf.hwf .hwf-chips a{display:inline-flex; align-items:center; height:34px; padding:0 15px; border:1px solid var(--hair2); border-radius:999px; font-size:14px; color:var(--t2); transition:color var(--d2) var(--ease), border-color var(--d2) var(--ease), background var(--d2) var(--ease), transform var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-chips a:hover{color:var(--w); border-color:rgba(58,189,188,.5); background:rgba(58,189,188,.08); transform:translateY(-2px);}

/* ticker — class-driven pause so JS (off-screen / press-and-hold) and CSS agree */
.hwf.hwf.hwf .hwf-tick{position:relative; overflow:hidden; flex:1 1 auto; min-width:0; max-width:min(560px,100%); touch-action:pan-y;
  -webkit-mask-image:linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  mask-image:linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);}
.hwf.hwf.hwf .hwf-tick-track{display:flex; width:max-content; animation:hwf-tick 40s linear infinite; backface-visibility:hidden; -webkit-backface-visibility:hidden;}
.hwf.hwf.hwf .hwf-tick-track.is-hold,
.hwf.hwf.hwf .hwf-tick-track.is-off{animation-play-state:paused;}
.hwf.hwf.hwf .hwf-tick-set{display:flex; align-items:center; gap:18px; padding-right:18px;}
.hwf.hwf.hwf .hwf-tick-i{display:inline-flex; align-items:center; gap:7px; font-family:var(--fd); font-size:12px; font-weight:400; letter-spacing:.06em; text-transform:uppercase; color:var(--t3); white-space:nowrap; transition:color var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-tick-i b{font-weight:600; color:var(--cyan);}
.hwf.hwf.hwf .hwf-tick-i::after{content:""; width:4px; height:4px; margin-left:11px; border-radius:50%; background:rgba(113,199,210,.6); flex:none;}
.hwf.hwf.hwf .hwf-tick.is-held .hwf-tick-i{color:var(--t2);}
@keyframes hwf-tick{from{transform:translate3d(0,0,0);}to{transform:translate3d(-50%,0,0);}}

/* ---------- LOCATIONS ---------- */
.hwf.hwf.hwf .hwf-locs{padding:18px 0; border-top:1px solid var(--hair); border-bottom:1px solid var(--hair);}
.hwf.hwf.hwf .hwf-locs-list{display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:12px 30px;}
.hwf.hwf.hwf .hwf-locs-list span{position:relative; font-size:15px; color:var(--t2); display:inline-flex; align-items:center; gap:8px;}
.hwf.hwf.hwf .hwf-locs-list span:not(:last-child)::after{content:""; position:absolute; right:-16px; top:50%; width:1px; height:13px; background:var(--hair2); transform:translateY(-50%);}

/* ---------- BOTTOM BAR ---------- */
.hwf.hwf.hwf .hwf-bottom{display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px 32px; padding:20px 0 0;}
.hwf.hwf.hwf .hwf-bottom-l,.hwf.hwf.hwf .hwf-bottom-r{display:flex; align-items:center; flex-wrap:wrap; gap:12px 20px;}
.hwf.hwf.hwf .hwf-soc2{flex:none; display:inline-flex; align-items:center; min-width:40px; min-height:40px; opacity:.7; transition:opacity var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-soc2:hover{opacity:1;}
.hwf.hwf.hwf .hwf-soc2 img{height:40px; width:auto; filter:brightness(0) invert(1);}
.hwf.hwf.hwf .hwf-copy{font-size:14px; color:var(--t3);}
.hwf.hwf.hwf .hwf-legal{display:flex; flex-wrap:wrap; align-items:center;}
.hwf.hwf.hwf .hwf-legal li{position:relative; font-size:14px; padding:0 16px;}
.hwf.hwf.hwf .hwf-legal li:first-child{padding-left:0;}
.hwf.hwf.hwf .hwf-legal li:not(:last-child)::after{content:""; position:absolute; right:0; top:50%; width:1px; height:12px; background:var(--hair2); transform:translateY(-50%);}
.hwf.hwf.hwf .hwf-legal a{color:var(--t3); transition:color var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-legal a:hover{color:var(--cyan);}
.hwf.hwf.hwf .hwf-top-btn{display:inline-flex; align-items:center; gap:8px; height:40px; padding:0 16px; border:1px solid var(--hair2); border-radius:999px; font-family:var(--fd); font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--t3); transition:color var(--d2) var(--ease), border-color var(--d2) var(--ease), background var(--d2) var(--ease);}
.hwf.hwf.hwf .hwf-top-btn:hover{color:var(--w); border-color:var(--hair3); background:var(--s1);}
.hwf.hwf.hwf .hwf-top-btn:hover .hwf-ar--up{transform:translateY(-3px);}

/* ---------- REVEAL ---------- */
.hwf.hwf.hwf.hwf-js .reveal{opacity:0; transform:translateY(8px); transition:opacity 500ms var(--ease), transform 500ms var(--ease);}
.hwf.hwf.hwf .reveal.hwf-in{opacity:1; transform:none;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(1){transition-delay:40ms;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(2){transition-delay:90ms;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(3){transition-delay:140ms;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(4){transition-delay:190ms;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(5){transition-delay:240ms;}
.hwf.hwf.hwf .hwf-cols .hwf-col:nth-child(6){transition-delay:290ms;}

/* ---------- ULTRAWIDE ----------
   The 1200px content column is held on purpose: the footer has to line up
   with the rest of the site. Only the rail, lead type and breathing room
   scale up. */
@media(min-width:1600px){
  .hwf.hwf.hwf{padding-top:32px;}
  .hwf.hwf.hwf .hwf-top{padding:22px 40px 32px;}
  .hwf.hwf.hwf .hwf-conv-h{font-size:38px;}
  .hwf.hwf.hwf .hwf-conv-sub{font-size:17px;}
  .hwf.hwf.hwf .hwf-tick{max-width:min(720px,100%);}
  .hwf.hwf.hwf .hwf-cols{gap:36px 30px; padding:44px 0 34px;}
}
@media(min-width:2200px){
  .hwf.hwf.hwf{padding-top:36px;}
  .hwf.hwf.hwf .hwf-tick{max-width:min(860px,100%);}
}

/* ---------- RESPONSIVE ---------- */
@media(max-width:1180px){
  .hwf.hwf.hwf .hwf-cols{grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px 26px;}
}
@media(max-width:1024px){
  .hwf.hwf.hwf .hwf-trust{flex-direction:column; flex-wrap:nowrap; align-items:stretch; gap:14px;}
  .hwf.hwf.hwf .hwf-trust-g--tick{justify-content:flex-start; flex:0 0 auto; width:100%;}
  .hwf.hwf.hwf .hwf-tick{max-width:100%;}
}
@media(max-width:680px){
  .hwf.hwf.hwf{padding-top:20px; --pad:22px;}
  .hwf.hwf.hwf .hwf-top{width:calc(100% - 32px); padding:16px 18px 24px; border-radius:16px; clip-path:inset(0 round 16px);}
  .hwf.hwf.hwf .hwf-top-aurora{top:-45%; left:-25%; width:110%; height:180%;}
  .hwf.hwf.hwf .hwf-top-aurora--b{display:none;}
  .hwf.hwf.hwf .hwf-top-grid{background-size:20px 20px; opacity:.35;}
  .hwf.hwf.hwf .hwf-top-line{left:8%; right:8%;}
  .hwf.hwf.hwf .hwf-tabs{width:100%;}
  .hwf.hwf.hwf .hwf-tab{flex:1; text-align:center; padding:13px 8px;}
  .hwf.hwf.hwf .hwf-news-inner{flex-direction:column; text-align:center;}
  .hwf.hwf.hwf .hwf-news-logo{width:140px;}
  .hwf.hwf.hwf .hwf-news-form{width:100%; justify-content:center; flex-wrap:wrap;}
  .hwf.hwf.hwf .hwf-news-field{flex:1 1 100%;}
  .hwf.hwf.hwf .hwf-news-act{width:100%; flex-basis:auto;}
  .hwf.hwf.hwf .hwf-cols{grid-template-columns:repeat(2,minmax(0,1fr)); gap:30px 22px;}
  .hwf.hwf.hwf .hwf-col--touch{grid-column:span 2;}
  .hwf.hwf.hwf .hwf-conv-actions{gap:16px;}
  .hwf.hwf.hwf .hwf-conv-actions .hwf-cta{width:100%; justify-content:space-between; padding-left:24px;}
  .hwf.hwf.hwf .hwf-sub{width:100%;}
  /* ticker: label above the rail so the rail keeps the full width */
  .hwf.hwf.hwf .hwf-trust-g--tick{flex-wrap:wrap; gap:8px;}
  .hwf.hwf.hwf .hwf-trust-g--tick .hwf-trust-h{flex:1 1 100%;}
  .hwf.hwf.hwf .hwf-tick{flex:1 1 100%; width:100%;
    -webkit-mask-image:linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image:linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);}
  .hwf.hwf.hwf .hwf-bottom{flex-direction:column; align-items:center; text-align:center;}
  .hwf.hwf.hwf .hwf-bottom-l,.hwf.hwf.hwf .hwf-bottom-r{justify-content:center;}
  .hwf.hwf.hwf .hwf-legal li:first-child{padding-left:16px;}
  .hwf.hwf.hwf .hwf-locs-list{gap:10px 20px;}
